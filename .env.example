# Any LiteLLM model string works: anthropic/..., openai/gpt-4o-mini, gemini/...
MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me

CRM_BASE_URL=http://localhost:8001
CRM_DB_PATH=crm.sqlite3
AGENT_MAX_TURNS=5

# Optional: queue updates in Redis Streams and run the agent in `python -m app.worker`
REDIS_URL=
